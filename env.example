# /etc/pve-offsite-backup/env  -- root only (chmod 600).
# Sourced by bash: keep the single quotes.
# Keep a copy of the restic password and the B2 key OUTSIDE the server:
# without them the backups cannot be read.

# Backblaze B2 via its S3 API: s3:https://<endpoint shown on the bucket page>/<bucket>
RESTIC_REPOSITORY='s3:https://s3.eu-central-003.backblazeb2.com/example-offsite-7f3k'
RESTIC_PASSWORD_FILE='/path/to/pass'
AWS_ACCESS_KEY_ID='id'
AWS_SECRET_ACCESS_KEY='key'

# OPNsense API key of the "backup" user (privilege: Diagnostics: Configuration History)
OPN_HOST='ip'
OPN_KEY='key'
OPN_SECRET='secret'

# SHA-256 of the GUI certificate's public key.
# Survives the cert expiring; changes only if the cert is regenerated.
# Recompute on the Proxmox host with:
#   openssl s_client -connect IP:PORT </dev/null 2>/dev/null | openssl x509 -pubkey -noout \
#     | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | openssl base64
OPN_PIN='pin'

# healthchecks.io check URL, no trailing slash
# Empty = off.
HC_URL='https://hc-ping.com/5e0c9a12-7b3d-4f81-a6e2-0d94c3b7f158'

# Metrics for prometheus-node-exporter's textfile collector:
# Writes pve_offsite_backup.prom into this directory.
# Empty = off.
PROM_TEXTFILE_DIR='/var/lib/prometheus/node-exporter'

# Retention.
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=3
PRUNE_INTERVAL_DAYS=7

# Fail (healthcheck alerts) once the repo is bigger than this, in decimal MB as B2 counts them.
REPO_MAX_MB=9000
